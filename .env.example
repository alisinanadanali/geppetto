# Kopyala: cp .env.example .env  (docker compose ve uygulamalar okur)

# --- PostgreSQL (infra/docker-compose.yml)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=geppetto
POSTGRES_PORT=5432
GEPPETTO_MIGRATE_PASSWORD=migrate
GEPPETTO_APP_PASSWORD=app
GEPPETTO_SYSTEM_PASSWORD=system

# Uygulama bağlantıları (ADR-0007: çalışma zamanı app rolü, migration ayrı rol)
DATABASE_URL=postgresql+asyncpg://geppetto_app:app@localhost:5432/geppetto
MIGRATION_DATABASE_URL=postgresql+asyncpg://geppetto_migrate:migrate@localhost:5432/geppetto

# --- Redis (arq)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3 uyumlu; StoragePort)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=geppetto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
