{
  "$defs": {
    "DimensionBasis": {
      "description": "İthal edilen ölçünün esası (ADR-0009). Varsayılanı yoktur; kullanıcı onaylar.",
      "enum": [
        "FINISHED",
        "RAW"
      ],
      "title": "DimensionBasis",
      "type": "string"
    },
    "EdgeBandRef": {
      "additionalProperties": false,
      "description": "Bir kenara vurulan bant: kaynaktaki ad/kod ve eşlendiyse malzeme kimliği.",
      "properties": {
        "material_ref": {
          "minLength": 1,
          "title": "Material Ref",
          "type": "string"
        },
        "material_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        }
      },
      "required": [
        "material_ref"
      ],
      "title": "EdgeBandRef",
      "type": "object"
    },
    "EdgeBands": {
      "additionalProperties": false,
      "description": "Dört kenarın bant ataması. Alan adları `EdgeRef` değerleridir; bantsız kenar `None`.",
      "properties": {
        "L1": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeBandRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "L2": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeBandRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "W1": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeBandRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "W2": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeBandRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EdgeBands",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "PART_EXCEEDS_SHEET",
        "PART_RAW_DIMENSION_NON_POSITIVE",
        "PART_ROTATION_CONFLICTS_GRAIN",
        "PART_FINISHED_ASSUMED_FROM_RAW",
        "IMPORT_DIMENSION_BASIS_REQUIRED",
        "IMPORT_ROW_INVALID",
        "IMPORT_MATERIAL_UNMAPPED",
        "IMPORT_EDGE_COUNT_AMBIGUOUS",
        "IMPORT_EDGES_MISSING",
        "IMPORT_NON_RECTANGULAR_OUTLINE",
        "IMPORT_UNKNOWN_LAYER",
        "SOLVER_OVERLAP",
        "SOLVER_OUT_OF_BOUNDS",
        "SOLVER_KERF_MISSING",
        "SOLVER_NOT_GUILLOTINE",
        "SOLVER_ROTATION_VIOLATION",
        "SOLVER_PART_COUNT_MISMATCH",
        "SOLVER_AREA_CONSERVATION",
        "SOLVER_NONDETERMINISTIC",
        "MATERIAL_TYPE_IMMUTABLE",
        "MATERIAL_CURRENCY_MISMATCH"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "Tek hata veya uyarı: kod, parametreler, opsiyonel alan yolu.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "required": [
        "code"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Grain": {
      "description": "Parça damar yönü (ADR-0006). `NONE` dışındaki değerler 90° dönüşü yasaklar.",
      "enum": [
        "NONE",
        "ALONG_LENGTH",
        "ALONG_WIDTH"
      ],
      "title": "Grain",
      "type": "string"
    },
    "PartListRow": {
      "additionalProperties": false,
      "description": "Kaynak listedeki tek satır. Ölçüler `dimension_basis`'e göre bitmiş veya ham.",
      "properties": {
        "row_index": {
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "material_ref": {
          "title": "Material Ref",
          "type": "string"
        },
        "material_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "length_um": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Length Um",
          "type": "integer"
        },
        "width_um": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Width Um",
          "type": "integer"
        },
        "thickness_um": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thickness Um"
        },
        "qty": {
          "exclusiveMinimum": 0,
          "title": "Qty",
          "type": "integer"
        },
        "edges": {
          "$ref": "#/$defs/EdgeBands"
        },
        "rotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Ref"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "row_index",
        "label",
        "material_ref",
        "length_um",
        "width_um",
        "qty"
      ],
      "title": "PartListRow",
      "type": "object"
    },
    "PartListSource": {
      "additionalProperties": false,
      "description": "Belgenin kaynağı (izlenebilirlik).",
      "properties": {
        "profile_id": {
          "format": "uuid",
          "title": "Profile Id",
          "type": "string"
        },
        "file_name": {
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "file_hash": {
          "minLength": 1,
          "title": "File Hash",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "file_name",
        "file_hash",
        "imported_at"
      ],
      "title": "PartListSource",
      "type": "object"
    },
    "Rotation": {
      "description": "Yerleşimde izin verilen dönüşler (ADR-0006).",
      "enum": [
        "NONE",
        "ROT_180",
        "ROT_90",
        "ANY"
      ],
      "title": "Rotation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "İthalat belgesi, şema sürümü 1.",
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "dimension_basis": {
      "$ref": "#/$defs/DimensionBasis"
    },
    "unit_note": {
      "title": "Unit Note",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/PartListSource"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/PartListRow"
      },
      "title": "Rows",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "dimension_basis",
    "unit_note",
    "source",
    "rows"
  ],
  "title": "PartListDocument",
  "type": "object"
}
